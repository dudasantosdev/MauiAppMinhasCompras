<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiAppMinhasCompras.Views.NovoProduto"
    Title="Novo Produto">

    <ScrollView>
        <VerticalStackLayout
            Padding="30"
            Spacing="15">

            <Label
                Text="Novo Produto"
                FontSize="28"
                HorizontalOptions="Center" />

            <Entry
                x:Name="txtDescricao"
                Placeholder="Descrição do produto" />

            <Entry
                x:Name="txtQuantidade"
                Placeholder="Quantidade"
                Keyboard="Numeric" />

            <Entry
                x:Name="txtPreco"
                Placeholder="Preço"
                Keyboard="Numeric" />

            <Button
                Text="Salvar"
                Clicked="OnSalvarClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>